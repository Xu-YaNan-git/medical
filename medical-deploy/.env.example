# ===== AI 医疗智能助手 · 演示部署配置 =====
# 用法：cp .env.example .env 后按需修改（deploy.sh up 会自动复制）。
# .env 含密钥时请勿提交到仓库、勿贴到聊天/日志。

# --- 大模型（可空：LLM_API_KEY 为空时两端自动走规则 Mock，可完整演示） ---
LLM_API_KEY=
# OpenAI 兼容接口地址（留空用代码内默认值；会自动补 /v1）
LLM_BASE_URL=
# 模型名（留空用代码内默认值 gpt-5.6-sol；护栏 LLM 二次判定也读这个变量）
LLM_MODEL=gpt-5.6-sol

# --- 运行环境 ---
# demo/dev 为非生产：允许 POST /api/demo/reset；prod/production 才视为生产
APP_ENV=demo
# 敏感字段强制脱敏（手机号、证件号等），演示请保持 1
MASK_SENSITIVE=1
# 存储后端：sqlite（落盘到 volume，重启不丢）| memory（重启清空）
STORE_BACKEND=sqlite
# 生产环境下仍允许演示重置（仅在 APP_ENV=prod 时有意义，慎用）
# ALLOW_RESET_IN_PROD=1

# --- AI 护栏（S2）---
# 1 = 启用（默认）：红旗症状直接急诊提示、注入/越权/处方剂量请求拒答、输出去诊断/剂量 + 免责声明
# 0 = 关闭（仅排障用）。护栏包缺失或异常时自动 fail-open，不影响服务可用性
GUARDRAILS_ENABLED=1
# 可选：护栏 LLM 二次判定（护栏包 0.2.0+）。默认不设 = 有 LLM_API_KEY 时开启（超时 3s，失败自动跳过）。
# 冒烟/回归建议设 0，结果只由规则决定、稳定可复现：GUARDRAILS_LLM=0
# GUARDRAILS_LLM=
# 可选：自定义护栏包源码目录（默认 ../medical-guardrails，需为 compose 文件的相对/绝对路径）
# GUARDRAILS_SRC=../medical-guardrails

# --- CORS（可选）---
# 浏览器默认只经 web（8765/36967）同源反代访问 API，无需配置。
# 仅当浏览器要从其他主机直连 8001/8000 时才需放开，例如局域网：
# CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?

# --- 宿主机端口映射（端口冲突时修改左侧值） ---
PATIENT_API_PORT=8001
DOCTOR_API_PORT=8000
PATIENT_UI_PORT=8765
DOCTOR_UI_PORT=36967
